---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SpecimenCard from "../components/SpecimenCard.astro";
import { SITE } from "../config/site";
import { inStock, bloomingNow } from "../lib/products";

const featured = bloomingNow()[0] ?? inStock()[0];
const fresh = inStock().filter((p) => p.slug !== featured?.slug).slice(0, 6);
---
<Base title={`${SITE.name} — ${SITE.tagline}`} description={SITE.tagline}>
  {featured && <Hero product={featured} />}

  <section class="mx-auto max-w-[75rem] px-5 py-12">
    <div class="flex items-end justify-between">
      <div>
        <p class="eyebrow">In stock now</p>
        <h2 class="latin mt-1 text-3xl text-ink">Orchids ready to ship</h2>
      </div>
      <a href="/shop/" class="text-sm text-conservatory hover:text-petal">Browse all orchids →</a>
    </div>
    <div class="botanical-rule mt-4"></div>
    <div class="mt-7 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {fresh.map((p, i) => <SpecimenCard product={p} plateNo={i + 1} />)}
    </div>
  </section>

  <!-- Homepage entry points — each new-vs-old-site feature one click away (Edit 003) -->
  <section class="mx-auto max-w-[75rem] px-5 pb-4">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      <a href="/shop/" class="lift botanical-rule border border-line bg-paper p-5 pt-4">
        <p class="eyebrow eyebrow--leaf">Search &amp; filter</p>
        <h3 class="latin mt-1 text-2xl text-ink">Find an orchid fast</h3>
        <p class="mt-2 text-sm text-ink/75">Search by name, or filter by genus, care level, and what's in bloom.</p>
      </a>
      <a href="/care/" class="lift botanical-rule border border-line bg-paper p-5 pt-4">
        <p class="eyebrow eyebrow--leaf">Care guides</p>
        <h3 class="latin mt-1 text-2xl text-ink">Learn how to grow it</h3>
        <p class="mt-2 text-sm text-ink/75">A practical guide for every genus we sell — light, water, temperature, difficulty.</p>
      </a>
      <a href="/conservatory/" class="lift botanical-rule border border-line bg-paper p-5 pt-4">
        <p class="eyebrow eyebrow--leaf">Currently growing</p>
        <h3 class="latin mt-1 text-2xl text-ink">Get notified when it's back</h3>
        <p class="mt-2 text-sm text-ink/75">Browse what's between flushes and join the list for its return.</p>
      </a>
    </div>
  </section>
</Base>
