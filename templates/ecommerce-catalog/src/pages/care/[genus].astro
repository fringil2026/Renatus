---
import Base from "../../layouts/Base.astro";
import SpecimenCard from "../../components/SpecimenCard.astro";
import { SITE } from "../../config/site";
import { careGuides, type CareGuide } from "../../lib/care";
import { faqSchema, breadcrumbSchema } from "../../lib/schema";

export function getStaticPaths() {
  return careGuides().map((g) => ({ params: { genus: g.slug }, props: { guide: g } }));
}
const { guide } = Astro.props as { guide: CareGuide };
const origin = Astro.site?.origin ?? "";
const pageUrl = new URL(`/care/${guide.slug}/`, origin).href;
const faqLd = faqSchema(guide.faq);
const crumbs = breadcrumbSchema([
  { name: "Home", url: new URL("/", origin).href },
  { name: "Care guides", url: new URL("/care/", origin).href },
  { name: guide.genus, url: pageUrl },
]);
const facts: Array<[string, string]> = [
  ["Light", guide.light],
  ["Water", guide.water],
  ["Temperature", `${guide.temps.join(" / ")}-growing`],
  ["Care level", guide.difficulties.join(" / ")],
  ["Origin", guide.origins.map((o) => o.split("·")[0].trim()).join(", ")],
];
---
<Base title={`How to grow ${guide.genus} — care guide · ${SITE.name}`} description={`Light, water, temperature and difficulty for growing ${guide.genus} orchids.`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <section class="bg-conservatory text-paper">
    <div class="mx-auto max-w-[75rem] px-5 py-10">
      <p class="eyebrow eyebrow--leaf">Care guide</p>
      <h1 class="latin mt-1 text-5xl text-paper">How to grow {guide.genus}</h1>
      <p class="mt-3 max-w-2xl text-paper/80">A practical guide drawn from the {guide.count} {guide.genus} {guide.count === 1 ? "plant" : "plants"} we grow. <span class="text-paper/60">(Draft horticulture — refined with Andy's notes.)</span></p>
    </div>
  </section>

  <section class="mx-auto max-w-[75rem] px-5 py-9">
    <dl class="grid grid-cols-[8rem_1fr] gap-y-3 text-sm">
      {facts.map(([k, v]) => (
        <Fragment>
          <dt class="mono-label">{k}</dt>
          <dd class="text-ink/85">{v}</dd>
        </Fragment>
      ))}
    </dl>

    <h2 class="latin botanical-rule mt-9 pt-6 text-2xl text-ink">Common questions</h2>
    <div class="mt-4 divide-y divide-line">
      {guide.faq.map((item) => (
        <details class="py-3">
          <summary class="cursor-pointer text-ink">{item.q}</summary>
          <p class="mt-2 text-sm text-ink/75">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[75rem] px-5 pb-12">
    <h2 class="latin text-2xl text-ink">{guide.genus} in the catalogue</h2>
    <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {guide.examples.map((p, i) => <SpecimenCard product={p} plateNo={i + 1} />)}
    </div>
  </section>
</Base>
