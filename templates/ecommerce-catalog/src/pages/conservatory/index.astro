---
import Base from "../../layouts/Base.astro";
import SpecimenPhoto from "../../components/SpecimenPhoto.astro";
import CareGlyphs from "../../components/CareGlyphs.astro";
import { SITE } from "../../config/site";
import { outOfStock, latin } from "../../lib/products";

// The Conservatory: the out-of-stock gallery, framed as a feature not an apology.
// Each card carries a single-field "Notify me" capture. In Phase 4 the form POSTs
// to /api/notify; in Phase 1 it is a real, labelled, non-submitting placeholder so
// no capture is silently dropped.
const growing = outOfStock();
---
<Base title={`The Conservatory — ${SITE.name}`} description="Specimens currently growing in the greenhouse. Join the list to hear when they return.">
  <section class="bg-conservatory text-paper">
    <div class="mx-auto max-w-[75rem] px-5 py-12">
      <p class="eyebrow">The Conservatory</p>
      <h1 class="latin mt-2 text-5xl text-paper">Currently growing</h1>
      <p class="mt-3 max-w-xl text-paper/80">
        These specimens are between flushes — rooting, dividing, or coming back into bloom.
        Browse them like any plate, and join the list to hear the moment one returns to the bench.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[75rem] px-5 py-10">
    {growing.length === 0 ? (
      <p class="botanical-rule pt-8 text-center text-moss">Every specimen is in stock right now — nothing in the conservatory.</p>
    ) : (
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {growing.map((p, i) => (
          <article id={p.slug} class="flex flex-col border border-line bg-paper">
            <div class="aspect-[5/4] w-full">
              <SpecimenPhoto product={p} plateNo={i + 1} class="h-full w-full" />
            </div>
            <div class="specimen-tag flex flex-1 flex-col px-4 pb-4 pt-3">
              <h2 class="latin text-xl text-ink">{latin(p)}</h2>
              <p class="text-sm text-ink/80">{p.common_name}</p>
              <p class="mono-label mt-1">{p.origin}</p>
              <div class="mt-3"><CareGlyphs product={p} /></div>
              <form
                class="botanical-rule mt-4 flex gap-2 pt-4"
                data-notify={p.id}
                aria-label={`Notify me when ${latin(p)} is available`}
                onsubmit="return false"
              >
                <label class="sr-only" for={`notify-${p.slug}`}>Email for {latin(p)}</label>
                <input
                  id={`notify-${p.slug}`}
                  type="email"
                  required
                  placeholder="you@email.com"
                  class="min-w-0 flex-1 border border-line bg-paper px-2.5 py-1.5 text-sm text-ink"
                />
                <button type="submit" class="bg-petal px-3 py-1.5 text-xs tracking-wide text-paper hover:bg-conservatory transition-colors">
                  Join list
                </button>
              </form>
              <p class="mono-label mt-2 !normal-case !tracking-normal text-moss">currently growing — join the list</p>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
