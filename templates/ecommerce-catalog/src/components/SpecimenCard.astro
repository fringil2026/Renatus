---
// Herbarium v2 — photo-forward, quiet. A large portrait photo carries the card; below it a single
// hairline tag with the italic binomial, one concrete attribute line, price + one CTA. The old
// care-glyph icons + badge pair are dropped to reduce simultaneous visual ideas.
import type { Product } from "../lib/products";
import { latin, priceLabel, isAvailable } from "../lib/products";
import SpecimenPhoto from "./SpecimenPhoto.astro";
interface Props { product: Product; plateNo?: number; }
const { product, plateNo } = Astro.props;
const available = isAvailable(product);
const href = `/shop/${product.slug}/`;
const attrs = [product.origin, `${product.difficulty} care`].filter(Boolean).join(" · ");
---
<article class="lift group flex flex-col border border-line/60 bg-paper">
  <a href={href} class="block aspect-[4/5] w-full">
    <SpecimenPhoto product={product} plateNo={plateNo} class="h-full w-full" />
  </a>
  <div class="flex flex-1 flex-col gap-2 px-5 pb-6 pt-4">
    <div class="flex items-start justify-between gap-3">
      <a href={href}><h3 class="latin text-2xl leading-tight text-ink group-hover:text-petal">{latin(product)}</h3></a>
    </div>
    <p class="text-sm text-ink/70">{product.common_name}</p>
    <p class="mono-label">{attrs}</p>
    <div class="mt-auto flex items-center justify-between pt-3">
      {available ? (
        <>
          <span class="text-lg text-ink">{priceLabel(product)}</span>
          <a href={href} class="text-sm text-conservatory underline-offset-4 hover:text-petal hover:underline">View &amp; buy →</a>
        </>
      ) : (
        <>
          <span class="mono-label">Currently growing</span>
          <a href={`/conservatory/#${product.slug}`} class="text-sm text-petal underline-offset-4 hover:underline">Notify me →</a>
        </>
      )}
    </div>
  </div>
</article>
