---
// Herbarium v2 — photo-forward. A real photo fills the slot as the loudest element (never
// upscaled past native — slots are built to accept large imagery, so D-2.7.4 originals scale in
// with zero rework). No-photo products get a CLEAN TYPE-LED card (big italic binomial on paper),
// NOT a fake botanical plate. Prototype may use the client's own scraped photos; production
// requires provenance-confirmed imagery (enforced at "Finish").
import type { Product } from "../lib/products";
import { latin, isAvailable } from "../lib/products";
interface Props { product: Product; plateNo?: number; class?: string; }
const { product, plateNo, class: klass = "" } = Astro.props;
const oos = !isAvailable(product);
const hasPhoto = product.photos.length > 0;
const alt = `${latin(product)} — ${product.common_name}`;
---
<div class:list={["relative overflow-hidden", hasPhoto ? "bg-ink/5" : "bg-paper-2", oos && "oos-photo", klass]}>
  {hasPhoto ? (
    <img src={product.photos[0]} alt={alt} class="specimen-img h-full w-full object-cover object-center" loading="lazy" />
  ) : (
    <div class="flex h-full w-full flex-col items-center justify-center px-5 text-center">
      <span class="latin text-2xl leading-tight text-ink/80">{latin(product)}</span>
      <span class="mono-label mt-2 !text-moss/70">photograph coming</span>
    </div>
  )}
  {plateNo && <span class="plate-no absolute right-2 top-2">Pl. {String(plateNo).padStart(2, "0")}</span>}
  {oos && <span class="in-culture absolute bottom-2 left-2 bg-paper/85">In Cultivation</span>}
</div>
