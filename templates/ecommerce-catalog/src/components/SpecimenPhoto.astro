---
// Renders the real photo when product.photos is set, else a labelled botanical
// placeholder so layout is real with no image. Per the studio image rule, a
// prototype may use the client's OWN scraped photos here; production requires
// provenance-confirmed imagery (enforced at "Finish").
import type { Product } from "../lib/products";
import { latin, isAvailable } from "../lib/products";
interface Props { product: Product; plateNo?: number; class?: string; }
const { product, plateNo, class: klass = "" } = Astro.props;
const oos = !isAvailable(product);
const hasPhoto = product.photos.length > 0;
const alt = hasPhoto
  ? `${latin(product)} — ${product.common_name}`
  : `Placeholder plate for ${latin(product)} (licensed photograph pending — FOR REVIEW)`;
---
<div class:list={["relative overflow-hidden bg-paper-2", oos && "oos-photo", klass]}>
  {hasPhoto ? (
    <img src={product.photos[0]} alt={alt} class="specimen-img h-full w-full object-cover" loading="lazy" />
  ) : (
    <svg viewBox="0 0 400 320" role="img" aria-label={alt} class="h-full w-full">
      <rect width="400" height="320" fill="var(--color-paper-2)" />
      <g fill="none" stroke="var(--color-moss)" stroke-width="1.1" opacity="0.55">
        <path d="M200 250 C200 170 200 120 200 80" />
        <path d="M200 150 C160 120 120 130 110 100 C150 105 175 120 200 150 Z" fill="var(--color-moss)" fill-opacity="0.10" />
        <path d="M200 150 C240 120 280 130 290 100 C250 105 225 120 200 150 Z" fill="var(--color-moss)" fill-opacity="0.10" />
        <path d="M200 180 C170 165 140 175 132 150 C165 152 185 162 200 180 Z" fill="var(--color-moss)" fill-opacity="0.10" />
        <path d="M200 180 C230 165 260 175 268 150 C235 152 215 162 200 180 Z" fill="var(--color-moss)" fill-opacity="0.10" />
        <ellipse cx="200" cy="115" rx="20" ry="26" fill="var(--color-petal)" fill-opacity="0.18" />
      </g>
      <text x="200" y="296" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1" fill="var(--color-moss)">
        PLATE PENDING · ORIGINAL PHOTOGRAPHY
      </text>
    </svg>
  )}
  <span class="mount-corner tl"></span><span class="mount-corner tr"></span>
  <span class="mount-corner bl"></span><span class="mount-corner br"></span>
  {plateNo && <span class="plate-no absolute right-2 top-2 bg-paper/80 px-1.5">Pl. {String(plateNo).padStart(2, "0")}</span>}
  {oos && (
    <span class="in-culture absolute bottom-2 left-2 bg-paper/85">In Cultivation</span>
  )}
</div>
