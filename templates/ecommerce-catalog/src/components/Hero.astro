---
// "Specimen of the Week" — one macro plate on the conservatory-green field with a
// plate-style caption bottom-left and a single CTA. In Phase 2 the admin picks the
// featured product; in Phase 1 we feature the first blooming in-stock specimen.
import type { Product } from "../lib/products";
import { latin, priceLabel } from "../lib/products";
import SpecimenPhoto from "./SpecimenPhoto.astro";
interface Props { product: Product; }
const { product } = Astro.props;
const href = `/shop/${product.slug}/`;
---
<!-- Herbarium v2 hero: photo-forward, quiet. The photo gets the largest honest area; type stays
     out of its way. Slot is built to accept large imagery — D-2.7.4 originals fill it with no
     layout change (and a real ≥1600px shot can go full-bleed later). -->
<section class="bg-conservatory text-paper">
  <div class="mx-auto grid max-w-[78rem] items-center gap-8 px-5 py-12 md:grid-cols-[1.1fr_1fr] md:gap-14 md:py-16">
    <div class="order-1">
      <SpecimenPhoto product={product} class="aspect-[4/5] w-full" />
    </div>
    <div class="order-2 flex flex-col justify-center">
      <p class="eyebrow">Specimen of the week</p>
      <h1 class="latin mt-4 text-6xl leading-[1.0] text-paper md:text-7xl">{latin(product)}</h1>
      <p class="mt-3 text-lg text-paper/85">{product.common_name}</p>
      <p class="mono-label mt-2 !text-paper/55">{product.origin}</p>
      <p class="mt-6 max-w-md text-paper/75">{product.description}</p>
      <div class="mt-8 flex items-center gap-5">
        <a href={href} class="bg-petal px-6 py-3 text-sm tracking-wide text-paper hover:bg-paper hover:text-conservatory transition-colors">View &amp; buy</a>
        <span class="text-paper/80">{priceLabel(product)}</span>
      </div>
    </div>
  </div>
</section>
