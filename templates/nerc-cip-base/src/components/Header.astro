---
import { SITE } from "../config/site";
const nav = [
  { href: "/services/", label: "Services" },
  { href: "/about/", label: "Firm" },
  { href: "/contact/", label: "Contact" },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-line bg-ink/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5">
    <a href="/" class="group flex items-center gap-3">
      <span class="grid h-9 w-9 place-items-center border border-amber-deep font-display text-lg font-bold text-amber" aria-hidden="true">M</span>
      <span class="leading-tight">
        <span class="block font-display text-lg font-semibold tracking-wide uppercase">{SITE.name}</span>
        <span class="block font-mono text-[0.6rem] tracking-[0.25em] text-muted uppercase">NERC CIP · Managed Compliance</span>
      </span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-6">
      {nav.map((n) => (
        <a href={n.href} class:list={["hidden font-mono text-xs tracking-[0.15em] uppercase transition-colors hover:text-amber sm:block", path.startsWith(n.href) ? "text-amber" : "text-paper"]}>{n.label}</a>
      ))}
      <a href="/contact/" class="border border-amber bg-amber px-4 py-2 font-display text-sm font-semibold tracking-wide text-ink uppercase transition-colors hover:bg-transparent hover:text-amber">
        Request an assessment
      </a>
    </nav>
  </div>
</header>
