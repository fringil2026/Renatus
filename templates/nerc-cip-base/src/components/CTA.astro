---
interface Props { title?: string; }
const { title = "Start with a two-week gap assessment" } = Astro.props;
---
<section class="relative overflow-hidden border-t border-line">
  <div class="grid-tex absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 py-16 md:flex-row md:items-center md:justify-between md:py-20">
    <div>
      <p class="eyebrow">Next step</p>
      <h2 class="mt-2 max-w-xl font-display text-3xl font-bold uppercase tracking-tight md:text-4xl">{title}</h2>
      <p class="mt-3 max-w-xl text-muted">Fixed scope, fixed price: we benchmark your program against current standard versions and hand you a ranked findings register — whether or not you engage us further.</p>
    </div>
    <a href="/contact/" class="shrink-0 border border-amber bg-amber px-7 py-3.5 font-display text-base font-semibold tracking-wide text-ink uppercase transition-colors hover:bg-transparent hover:text-amber">Request the assessment</a>
  </div>
</section>
