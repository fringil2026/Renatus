---
import services from "../data/services.json";
interface Props { detailed?: boolean; }
const { detailed = false } = Astro.props;
---
<section class="bg-paper text-ink">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="md:flex md:items-end md:justify-between">
      <div>
        <p class="eyebrow eyebrow--dark">Practice areas</p>
        <h2 class="mt-3 font-display text-4xl font-bold uppercase tracking-tight md:text-5xl">The full CIP lifecycle, managed</h2>
      </div>
      {!detailed && <a href="/services/" class="mt-4 inline-block font-mono text-xs tracking-[0.15em] uppercase underline decoration-amber-deep decoration-2 underline-offset-4 hover:text-amber-deep md:mt-0">All services →</a>}
    </div>
    <div class="mt-12 grid gap-px border border-line-light bg-line-light sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <article id={s.slug} class="group flex flex-col bg-paper p-7 transition-colors hover:bg-paper-2">
          <span class="cip-chip cip-chip--paper self-start">{s.code}</span>
          <h3 class="mt-4 font-display text-2xl font-semibold uppercase leading-tight tracking-tight">{s.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-dark">{s.summary}</p>
          {detailed && (
            <ul class="rule-tick rule-tick--paper mt-5 space-y-2 pt-4 text-sm">
              {s.points.map((p) => <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-amber-deep" aria-hidden="true"></span>{p}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
