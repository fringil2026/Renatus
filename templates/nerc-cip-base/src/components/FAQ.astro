---
// FAQ with FAQPage JSON-LD baked in — primary AEO surface of the template.
import faqs from "../data/faqs.json";
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<section class="bg-paper text-ink">
  <div class="mx-auto max-w-4xl px-5 py-20 md:py-24">
    <p class="eyebrow eyebrow--dark">Questions</p>
    <h2 class="mt-3 font-display text-4xl font-bold uppercase tracking-tight md:text-5xl">Compliance, in plain terms</h2>
    <div class="mt-10 divide-y divide-line-light border-y border-line-light">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 font-display text-xl font-semibold uppercase tracking-tight marker:hidden">
            {f.q}
            <span class="font-mono text-amber-deep transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-dark">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
