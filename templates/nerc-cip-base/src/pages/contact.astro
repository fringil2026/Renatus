---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE } from "../config/site";
---
<Base
  title="Contact — Meridian Grid Assurance"
  description="Request a NERC CIP gap assessment or talk to our compliance team. We respond within one business day."
>
  <section class="py-16 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="mt-3 font-display text-5xl font-bold uppercase tracking-tight">Talk to the practice</h1>
        <p class="mt-5 text-muted">Tell us your registration functions and where the program hurts. A principal — not a salesperson — replies within one business day.</p>
        <dl class="rule-tick mt-8 space-y-3 pt-6 font-mono text-sm">
          <div><dt class="inline text-muted">Tel · </dt><dd class="inline"><a class="hover:text-amber" href={`tel:${SITE.phone.replace(/[^+\d]/g, "")}`}>{SITE.phone}</a></dd></div>
          <div><dt class="inline text-muted">Mail · </dt><dd class="inline"><a class="hover:text-amber" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        </dl>
      </div>
      <div class="border border-line bg-panel/50 p-7 md:p-9">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
