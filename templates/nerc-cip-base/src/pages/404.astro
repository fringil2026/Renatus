---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Meridian Grid Assurance" description="The page you requested was not found.">
  <section class="relative overflow-hidden">
    <div class="grid-tex absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 py-28 text-center">
      <p class="cip-chip">HTTP 404</p>
      <h1 class="mt-5 font-display text-6xl font-bold uppercase tracking-tight">Not in evidence</h1>
      <p class="mx-auto mt-4 max-w-md text-muted">This page doesn't exist — possibly an old link from before the site was rebuilt.</p>
      <nav class="mt-8 flex justify-center gap-4" aria-label="Recovery">
        <a href="/" class="border border-amber bg-amber px-5 py-2.5 font-display font-semibold tracking-wide text-ink uppercase hover:bg-transparent hover:text-amber">Home</a>
        <a href="/services/" class="border border-line px-5 py-2.5 font-display font-semibold tracking-wide uppercase hover:border-amber hover:text-amber">Services</a>
        <a href="/contact/" class="border border-line px-5 py-2.5 font-display font-semibold tracking-wide uppercase hover:border-amber hover:text-amber">Contact</a>
      </nav>
    </div>
  </section>
</Base>
