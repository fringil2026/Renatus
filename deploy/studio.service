[Unit]
Description=Web Studio dashboard (studio.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=studio
Group=studio
WorkingDirectory=/home/studio/web-studio
# Secrets (STUDIO_TOKEN etc.) come from this file — never commit it.
EnvironmentFile=/etc/web-studio/studio.env
ExecStart=/usr/bin/python3 /home/studio/web-studio/studio.py
Restart=on-failure
RestartSec=3
# Light hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/studio/web-studio

[Install]
WantedBy=multi-user.target
