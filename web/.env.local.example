# Copy to .env.local for local dev. These are SERVER-side only (never exposed to the browser).
# The control-plane API the funnel calls (run it with: python3 -m api.server in the repo root):
API_BASE_URL=http://127.0.0.1:8099
# Tenant bearer token. Leave blank in single-tenant dev (auth off). In multi-tenant, set the
# tenant's token here (minted via POST /v1/tenants by an admin).
WS_TENANT_TOKEN=
